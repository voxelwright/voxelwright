{
  "name": "village-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Issue #140: Village's own engine. A world of cells drawn with raw WebGPU. Synthetic data. Its servers listen on this machine; strangers reach a world only through a dedicated server's door (#526).",
  "scripts": {
    "core": "node core/build.mjs",
    "serve": "node serve.mjs",
    "player": "npm run -s core && node player/build.mjs",
    "landing": "npm run -s player && node player/serve.mjs --port 5950",
    "check": "node test/all.mjs",
    "typecheck": "tsc --noEmit",
    "sf": "node test/sf-suite.mjs"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@webgpu/types": "0.1.74",
    "playwright": "1.65.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "node-datachannel": "0.33.6",
    "quickjs-emscripten-core": "0.32.0"
  }
}
