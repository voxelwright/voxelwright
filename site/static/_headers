# How long browsers keep the site's files (Workers static assets reads this at deploy, without
# running the Worker; scripts/serve.mjs follows it locally).
# A file not named here keeps the platform default, "public, max-age=0, must-revalidate" with an
# ETag: the browser checks before reusing it, so a deploy shows at once. Pages, Markdown twins,
# feeds and every unhashed script stay that way. Only a file whose name changes when its bytes do
# is kept for good.

# Security headers on every file of the origin (build.mjs keeps "/*" as it is when the site is mounted;
# src/worker.mjs sets the same on what it answers). The CSP limits only framing, plugins and <base>:
# the pages' inline scripts (speculation rules, the early theme script) stay allowed.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'

# The kit's shared modules are named by their content hash (chunk-<hash>.js).
/vendor/village/kit/shared/chunk-*
  Cache-Control: public, max-age=31536000, immutable

# Fonts keep their names when they change, but they almost never change: kept a week, then
# checked in the background for a month, so text doesn't wait on a check every page.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/vendor/village/kit/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/support/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
